# Copy to .env for local runs. In GitHub Actions these are repository secrets.

# Neon Postgres (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: a separate database (e.g. a Neon dev branch) for the DB tests
TEST_DATABASE_URL=

# Sources (on by default; Anibis also needs search URLs in the settings page)
HOMENOTIF_FLATFOX=1
HOMENOTIF_ANIBIS=1

# Email notifications: enabled when user + password are set and a notification address is saved in the settings
HOMENOTIF_SMTP_HOST=smtp.gmail.com
HOMENOTIF_SMTP_PORT=587
HOMENOTIF_SMTP_USER=
HOMENOTIF_SMTP_PASSWORD=

# Portal alert emails (ImmoScout24, Homegate, Comparis, Newhome), read over IMAP: enabled when the user is set
HOMENOTIF_IMAP_HOST=imap.gmail.com
HOMENOTIF_IMAP_USER=
HOMENOTIF_IMAP_PASSWORD=
HOMENOTIF_IMAP_FOLDER=INBOX

# Link in the emails
HOMENOTIF_DASHBOARD_URL=https://home-notifications.pages.dev
